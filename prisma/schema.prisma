// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Business {
  id                     String    @id
  name                   String
  slug                   String    @unique
  tagline                String
  description            String
  primaryCategory        String
  extraCategories        String[]  @default([])
  tags                   String[]  @default([])
  serviceModes           String[]  @default([])
  phone                  String
  whatsapp               String
  campus                 String    @default("Moi University (Kesses Main Campus)")
  zone                   String
  servesZones            String[]  @default([])
  landmark               String
  address                String?
  mapPin                 Json?
  walkTime               String?
  hours                  Json
  services               Json
  priceLevel             Int       @default(1)
  studentDiscount        String?
  photos                 String[]  @default([])
  coverPhoto             String
  activeTier             String    @default("NONE")
  tierEndsAt             DateTime?
  tierStartsAt           DateTime?
  proStartsAt            DateTime?
  proEndsAt              DateTime?
  media                  BusinessMedia[]
  planNotices            PlanNotice[]
  requestAlertsEnabled   Boolean @default(false)
  utilities              Json @default("{}")
  availabilityConfirmedAt DateTime?
  listingExpiresAt       DateTime?
  comradeListingKind     String?
  deals                  FlashDeal[]
  liveStatus             String?
  sellerType             String @default("SHOPFRONT")
  verificationVisitRequested Boolean @default(false)
  dealBlastEndsAt        DateTime?
  availableNowUntil      DateTime?
  isTemporarilyClosed    Boolean   @default(false)
  temporarilyClosedUntil DateTime?
  status                 String    @default("PENDING")
  verificationLevel      String    @default("L0")
  moderationReason       String?
  claimCode              String?
  isClaimed              Boolean   @default(false)
  ownerPhone             String?
  ownerId                String?
  ownerEmail             String?
  ownerName              String?
  invitationSentAt       DateTime?
  invitationError        String?
  owner                  Account? @relation(fields: [ownerId], references: [id])
  ambassadorId           String?
  profileStrength        Int       @default(0)
  metrics                Json
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([primaryCategory])
  @@index([zone])
  @@index([status])
  @@index([activeTier])
  @@index([tierEndsAt])
  @@index([ownerId])
  @@index([proEndsAt])
}

// Temporary, cookie-scoped photos for unverified registrations. No account is assigned until enrollment.
model EnrollmentMedia {
  id String @id @default(uuid())
  sessionHash String
  url String @unique
  bytes Int
  createdAt DateTime @default(now())
  @@index([sessionHash, createdAt])
  @@index([createdAt])
}

model BusinessAudit {
  id String @id @default(uuid())
  businessId String
  actorId String?
  action String
  details String?
  createdAt DateTime @default(now())
  @@index([businessId, createdAt])
}

model ProblemReport {
  id           String    @id
  businessId   String
  businessName String
  reason       String
  details      String?
  sessionId    String    @default("session_anon")
  createdAt    DateTime  @default(now())
  status       String    @default("OPEN")

  @@index([businessId])
  @@index([status])
}

model PaymentRecord {
  id            String    @id
  apiRef        String    @unique
  businessId    String
  businessName  String
  planId        String
  weeks         Int       @default(1)
  amountKes     Int       @default(100)
  phone         String
  state         String    @default("PENDING")
  submittedReceipt String?
  receiptNumber String?
  method        String    @default("STK_PUSH")
  mpesaRef      String?
  failedReason  String?
  createdAt     DateTime  @default(now())
  paidAt        DateTime?
  provider      String    @default("INTASEND")
  currency      String    @default("KES")
  checkoutId    String?   @unique
  checkoutUrl   String?
  checkoutSignature String?
  providerInvoiceId String? @unique
  providerRef   String?
  verifiedAt    DateTime?
  quoteTier     String?
  quoteTierEndsAt DateTime?

  @@index([businessId])
  @@index([state])
}

model ServiceRequest {
  id           String    @id
  query        String
  zone         String    @default("all")
  contactPhone String?
  category     String?
  contactConsent Boolean @default(false)
  closedAt DateTime?
  manageTokenHash String?
  createdAt    DateTime  @default(now())

  @@index([zone])
}

model BookingIntent {
  requesterId String?
  id          String    @id
  businessId  String
  serviceName String    @default("General inquiry")
  day         String    @default("Today")
  time        String    @default("Afternoon")
  studentName String    @default("Student")
  note        String?
  contactPhone String?
  status      String @default("NEW")
  createdAt   DateTime  @default(now())

  @@index([businessId])
}

model Account {
  id              String @id @default(uuid())
  email           String @unique
  name            String
  role            String @default("BUSINESS")
  phone           String? @unique
  phoneVerifiedAt DateTime?
  passwordHash    String?
  emailVerifiedAt DateTime?
  createdAt       DateTime @default(now())
  notifications   Notification[]
  pushDevices     PushDevice[]
  businesses      Business[]
  sessions        AccountSession[]
  tokens          VerificationToken[]
  uploads         UploadedPhoto[]
  media           BusinessMedia[]
}

model AccountSession {
  id        String @id @default(uuid())
  tokenHash String @unique
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([expiresAt])
}

model VerificationToken {
  id        String @id @default(uuid())
  tokenHash String @unique
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  purpose   String @default("INVITE")
  businessId String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  @@index([accountId])
}

model UploadedPhoto {
  id        String @id @default(uuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  content   Bytes
  mimeType  String @default("image/webp")
  createdAt DateTime @default(now())
}

model RequestLimit {
  key       String @id
  count     Int @default(0)
  resetsAt  DateTime
  @@index([resetsAt])
}

model Category {
  id          String    @id
  slug        String    @unique
  name        String
  icon        String
  description String
  color       String
  count       Int       @default(0)
}

model Zone {
  id                     String    @id
  slug                   String    @unique
  name                   String
  landmarkHint           String
  description            String
  center                 Json?
  walkTimeFromGate       String?
  distanceFromGateMeters Int?
}

// Includes reserved uploads so concurrent requests cannot exceed the Free quota.
model BusinessMedia {
  id          String   @id @default(uuid())
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id])
  businessId  String?
  business    Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  url         String?  @unique
  bytes       Int
  state       String   @default("RESERVED")
  createdAt   DateTime @default(now())
  @@index([businessId])
  @@index([accountId, businessId])
  @@index([state, createdAt])
}

model PlanNotice {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  endsAt      DateTime
  daysBefore  Int
  sentAt      DateTime?
  claimedAt   DateTime?
  error       String?
  @@unique([businessId, endsAt, daysBefore])
  @@index([sentAt])
}

// A browser binding is an opaque HttpOnly cookie, never a submitted account ID.
model PushDevice {
  id             String @id @default(uuid())
  bindingHash    String @unique
  accountId      String
  account        Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  token          String? @unique
  scopeBusinessId String?
  sessionHash    String?
  enrollmentUntil DateTime?
  enabled        Boolean @default(true)
  declined       Boolean @default(false)
  lastSeenAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  deliveries     NotificationDelivery[]
  @@index([accountId, enabled])
  @@index([lastSeenAt])
}

model Notification {
  id           String @id @default(uuid())
  accountId    String
  account      Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  eventKey     String
  kind         String
  title        String
  body         String
  path         String
  button       String
  createdAt    DateTime @default(now())
  readAt       DateTime?
  deliveries   NotificationDelivery[]
  @@unique([accountId, eventKey])
  @@index([accountId, createdAt])
}

model NotificationDelivery {
  id             String @id @default(uuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  channel        String
  target         String
  deviceId       String?
  device         PushDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  attempts       Int @default(0)
  nextAttemptAt  DateTime @default(now())
  claimedAt      DateTime?
  sentAt         DateTime?
  stoppedAt      DateTime?
  error          String?
  @@unique([notificationId, channel, target])
  @@index([sentAt, stoppedAt, nextAttemptAt])
}

// Student IDs stay in authenticated storage, separate from public gallery photos.
model VerificationProof {
  id String @id @default(uuid())
  sessionHash String
  businessId String? @unique
  content Bytes
  createdAt DateTime @default(now())
  @@index([sessionHash])
}
model BusinessEvent {
  id String @id @default(uuid())
  businessId String
  type String
  zone String?
  createdAt DateTime @default(now())
  @@index([businessId, createdAt])
}

model PhoneChallenge {
  id String @id @default(uuid())
  phone String
  name String
  codeHash String
  attempts Int @default(0)
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  @@index([expiresAt])
}
model MerchantAction {
  id String @id @default(uuid())
  tokenHash String @unique
  businessId String
  ownerId String
  kind String
  resourceId String?
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  @@index([expiresAt])
}
model FlashDeal {
  id String @id @default(uuid())
  businessId String
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title String
  priceKes Int
  endsAt DateTime
  dropZone String?
  dropAt DateTime?
  deliveryFeeKes Int?
  closedAt DateTime?
  createdAt DateTime @default(now())
  joins DropJoin[]
  @@index([endsAt])
}
model DropJoin {
  id String @id @default(uuid())
  dealId String
  deal FlashDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  sessionHash String
  createdAt DateTime @default(now())
  @@unique([dealId, sessionHash])
}
