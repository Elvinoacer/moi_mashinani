DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/moimashinani?schema=public"
APP_URL="http://localhost:3000"

# Cloudflare R2. Credentials are server-only; never prefix keys with NEXT_PUBLIC_.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="gtss"
R2_ENDPOINT="https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com"
R2_PUBLIC_URL="https://YOUR_PUBLIC_BUCKET.r2.dev"
NEXT_PUBLIC_R2_PUBLIC_URL="https://YOUR_PUBLIC_BUCKET.r2.dev"
# Dedicated folder in the shared bucket; must not be empty or contain '..'.
R2_KEY_PREFIX="moimashinani"

# SMTP credentials from your transactional email provider.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="MoiMashinani <accounts@your-domain.com>"
# Production always requires TLS. Use true for STARTTLS outside production.
SMTP_REQUIRE_TLS="false"

# IntaSend dashboard credentials. APP_URL must be HTTPS for checkout.
INTASEND_MODE="sandbox"
INTASEND_PUBLIC_KEY=""
INTASEND_SECRET_KEY=""
INTASEND_WEBHOOK_CHALLENGE=""

# One-time administrator bootstrap. Remove ADMIN_PASSWORD after use.
ADMIN_EMAIL=""
ADMIN_NAME="Main Administrator"
ADMIN_PASSWORD=""
