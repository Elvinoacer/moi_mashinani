DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/moimashinani?schema=public"
# Neon direct URL for migrations/introspection (hostname without -pooler).
# Leave empty for local PostgreSQL to reuse DATABASE_URL.
DATABASE_URL_UNPOOLED=""
# Optional: set to 4 on hosts without IPv6 connectivity; leave empty for automatic selection.
DATABASE_IP_FAMILY=""
APP_URL="http://localhost:3000"

# Cloudflare R2. Credentials are server-only; never prefix keys with NEXT_PUBLIC_.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="gtss"
R2_ENDPOINT="https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com"
R2_PUBLIC_URL="https://YOUR_PUBLIC_BUCKET.r2.dev"
NEXT_PUBLIC_R2_PUBLIC_URL="https://YOUR_PUBLIC_BUCKET.r2.dev"
# Dedicated folder in the shared bucket; must not be empty or contain '..'.
R2_KEY_PREFIX="moimashinani"

# Resend transactional email. Keep the API key server-only.
RESEND_API_KEY=""
EMAIL_FROM="Moi Mashinani <support@gtss.software>"

# IntaSend checkout, retry, verification and webhook routes share these variables.
# Use matching sandbox or live keys from the IntaSend dashboard.
# APP_URL must be the public HTTPS origin for checkout and webhook registration.
INTASEND_MODE="sandbox"
INTASEND_PUBLIC_KEY=""
INTASEND_SECRET_KEY=""
# Generate a random challenge and use the same value in the IntaSend webhook setup.
# Webhook URL: <APP_URL>/api/payments/webhook
INTASEND_WEBHOOK_CHALLENGE=""

# One-time administrator bootstrap. Remove ADMIN_PASSWORD after use.
ADMIN_EMAIL=""
ADMIN_NAME="Main Administrator"
ADMIN_PASSWORD=""

# Optional build/test overrides. Next.js normally uses .next.
NEXT_DIST_DIR=".next"
# Optional path to a system Chromium binary; omit to use Playwright's installation.
# PLAYWRIGHT_CHROMIUM_EXECUTABLE="/usr/bin/chromium"
# NODE_ENV is set by next dev/build/start; do not override it in .env.
# NODE_ENV="development"

# Protects plan reminders and unused upload cleanup, triggered every 15 minutes.
# Set the same long random server-only value locally and on the deployment.
# cron-job.org: send Authorization: Bearer <this value>; never put it in the URL.
CRON_SECRET=""
